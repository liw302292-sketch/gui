# =====================================================================
# Quote Engine / 报价引擎  —  环境变量示例
# 复制为 .env 后按需修改。所有变量都有安全的开发默认值。
# =====================================================================

# ---------- 基础 ----------
APP_NAME=Quote Engine
APP_ENV=development                 # development | production
# 公开报价链接的基础地址：
#   本地开发（前端 3000）          → http://localhost:3000
#   Docker / Nginx（前端 80 端口） → http://localhost
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
APP_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- 数据库 ----------
# Docker Compose 使用 PostgreSQL；本地零依赖开发可留空 → 自动使用 SQLite
DATABASE_URL=postgresql+psycopg://quote:quote@postgres:5432/quote_engine
# DATABASE_URL=sqlite:///./data/quote_engine.db

# ---------- Redis（可留空，自动降级为进程内缓存/限流）----------
REDIS_URL=redis://redis:6379/0

# ---------- DeepSeek AI ----------
# AI_MODE=mock  → 不需要任何 API Key，返回确定性演示数据
# AI_MODE=real  → 真实调用 DeepSeek
AI_MODE=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

# DeepSeek 峰谷计价（单位：元 / 百万 token）。留空则使用内置参考值。
AI_PRICE_FLASH_INPUT=0
AI_PRICE_FLASH_OUTPUT=0
AI_PRICE_PRO_INPUT=0
AI_PRICE_PRO_OUTPUT=0
AI_PRICE_VISION_INPUT=0
AI_PRICE_VISION_OUTPUT=0

# ---------- 文件存储 ----------
# 默认 local（服务器磁盘，通过鉴权接口访问）；生产可切换 s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=quote-engine
STORAGE_PUBLIC_BASE_URL=
MAX_UPLOAD_MB=20

# ---------- 安全 ----------
RATE_LIMIT_PER_MINUTE=240
AI_RATE_LIMIT_PER_MINUTE=20
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15

# ---------- 演示数据 ----------
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123456!
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=Demo123456!

# ---------- 支付（第一阶段为抽象层，默认 mock）----------
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_AUTO_PAID=true

# ---------- 前端 ----------
NEXT_PUBLIC_APP_NAME=报价引擎
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:8000
